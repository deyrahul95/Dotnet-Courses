@{
    ViewData["Title"] = "Home Page";
}
@model IEnumerable<Post>
@inject PersonalBlog.Interfaces.IAuthorizer authorizer;

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="fw-bold">My Blog</h1>

        @if (authorizer.IsAuthorize())
        {
            <a asp-action="CreatePost" class="btn btn-dark px-4">
                + New Post
            </a>
        }
    </div>

    <!-- Blog Grid -->
    <div class="row g-4">
        @foreach (var post in Model)
        {
            var content = post.Content?.Length > 220
                ? post.Content.Substring(0, 220) + "..."
                : post.Content;

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm blog-card">

                    <div class="card-body d-flex flex-column">
                        <p class="text-muted small mb-2">
                            @post.CreatedAt.ToString("MMMM dd, yyyy")
                        </p>

                        <h4 class="fw-semibold mb-3">
                            @post.Title
                        </h4>

                        <p class="text-secondary flex-grow-1">
                            @content
                        </p>

                        <a asp-action="Details" asp-route-id="@post.Id"
                               class="stretched-link text-decoration-none fw-semibold mt-3">
                            Read more →
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
</div>